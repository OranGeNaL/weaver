# Copy to .env and fill in. Never commit .env.

# --- Paths -------------------------------------------------------------------
# Absolute path on the Linux host with library/, staging/, .trash/, .backups/
MUSIC_ROOT=/srv/music

# --- Postgres -----------------------------------------------------------------
# The Hub's only database. Compose starts the postgres service with these credentials
# and the database below; the Hub connects with DATABASE_URL over the compose network.
# External Postgres: point DATABASE_URL at it and drop the postgres service. A hosted
# server must be UTF8 with a non-C ctype (C.UTF-8) for Cyrillic case-insensitive search.
POSTGRES_USER=hub
POSTGRES_PASSWORD=change-me
POSTGRES_DB=hub
DATABASE_URL=postgresql+asyncpg://hub:change-me@postgres:5432/hub

# --- Storage (S3 primary) -----------------------------------------------------
# Library audio and covers live in an S3-compatible bucket; the local disk keeps only staging and the hot cache.
# Compose starts RustFS with these credentials (S3_ENDPOINT=http://rustfs:9000). External S3: point S3_ENDPOINT at
# it, set the bucket/region/keys, drop the rustfs service. `fs` is for development and tests only: the Hub refuses
# to start with it in production.
ENVIRONMENT=production
STORAGE_BACKEND=s3
S3_ENDPOINT=http://rustfs:9000
S3_BUCKET=homemusic
S3_REGION=us-east-1
S3_ACCESS_KEY=hub
S3_SECRET_KEY=change-me-storage
# path-style requests are required by RustFS/MinIO; virtual-host style works for cloud S3 providers
S3_PATH_STYLE=true
# hot cache of blobs on the local disk (bytes); least recently used entries are evicted first
STORAGE_CACHE_MAX_BYTES=10737418240
# Service token of /api/media/blob/<sha256> (Authorization: Bearer): the embedder's fallback when presigned URLs
# are unavailable. Any long random string, e.g. `openssl rand -hex 24`.
MEDIA_BLOB_TOKEN=

# --- Public URLs -------------------------------------------------------------
# Addresses clients use to reach the services (a NetBird DNS name, a LAN address or another VPN/mesh).
# The Hub uses them for invite links and QR codes. Empty — external links are hidden.
PUBLIC_HUB_URL=https://hub.example.net


# --- Hub ---------------------------------------------------------------------
# Fernet key: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
HUB_SECRET_KEY=
# Signs the access JWTs (README, «Ключи и секреты»). Required: without it the Hub does not start.
# Any long random string: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SIGNING_KEY=
LOG_LEVEL=INFO
# The first administrator (README, «Первый администратор»). Without these and ADMIN_BOOTSTRAP_TOKEN the Hub creates
# no account at all (there is no default `admin/admin`). ADMIN_PASSWORD_HASH is an argon2id hash instead of a password.
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_PASSWORD_HASH=
# One-time token for POST /api/auth/bootstrap: creates the administrator and is spent for good.
ADMIN_BOOTSTRAP_TOKEN=
# Optional Netscape cookies exported for youtube.com (README, «YouTube просит проверку «не робот»»).
# Container path, e.g. /music/.youtube-cookies.txt; leave unset for anonymous downloads.
# YTDLP_COOKIES_FILE=/music/.youtube-cookies.txt
# Compose sets YTDLP_POT_BASE_URL=http://youtube-pot:4416 and persistent YTDLP_CACHE_DIR=/data/yt-dlp-cache.
# Outside Compose, point YTDLP_POT_BASE_URL at your local bgutil 2.0.2 server (no public port).
# Invite codes (admin → Пользователи → «Пригласить») are valid this many days by default.
INVITE_DAYS=7
# «Sign in with Google» in the app: the OAuth client id of the Web application type (README, «Вход через Google»).
# Empty — no Google sign-in. Not a secret.
GOOGLE_CLIENT_ID=
# The client secret of the same Web client: the Hub is an OIDC Relying Party now (README, «Вход через Google»).
GOOGLE_CLIENT_SECRET=
# Registration by email without an invite: a code in a letter (README, «Регистрация по почте»). SMTP of any mailbox;
# Gmail: smtp.gmail.com, 587, the address and an app password (free, ~500 letters a day). Empty host — no such registration.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# the sender's address; empty — SMTP_USER
SMTP_FROM=
# at most this many letters in 24 hours (Gmail sends ~500), then registration asks to try tomorrow
EMAIL_DAILY_LIMIT=450

# --- «Микс дня» (MIXES.md 6) ---------------------------------------------------
# Last.fm API key (free: https://www.last.fm/api/account/create): similar tracks/artists, tags for mix names.
# Empty — mixes are built from the other sources.
LASTFM_API_KEY=
LASTFM_SHARED_SECRET=
LASTFM_APPLICATION_NAME=
LASTFM_REGISTERED_TO=
# Users' local time: the hour a mix is built at (the containers run in UTC).
TIMEZONE=Europe/Moscow

# --- Embedder (audio vectors on the GPU, MIXES.md 4.2) ---------------------------
# The Hub calls it inside the compose network. The token is optional (the port is not published).
EMBEDDER_URL=http://embedder:8090
EMBEDDER_TOKEN=

# --- Soulseek (optional, off by default) ---------------------------------------
# A background source of lossless files for library downloads (never for listening). It is on only when all
# three values below are set; COMPOSE_PROFILES=soulseek also starts the slskd container. A new username
# registers itself on the first login. SLSKD_API_KEY: any random string, e.g. `openssl rand -hex 24`.
# COMPOSE_PROFILES=soulseek
SLSKD_API_KEY=
SLSKD_SLSK_USERNAME=
SLSKD_SLSK_PASSWORD=
# Optional overrides for a slow or unavailable Soulseek server endpoint.
# SLSKD_SLSK_PORT=2242
# SLSKD_SLSK_CONNECTION_TIMEOUT=15000

# --- AI (any OpenAI-compatible API) ------------------------------------------
# OpenRouter: https://openrouter.ai/keys
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
LLM_MODEL=anthropic/claude-haiku-5.5
# USD per 1M tokens, for cost logging
LLM_PRICE_IN=0.10
LLM_PRICE_OUT=0.50
# Fallback: local Ollama (RTX 5060 Ti 16 GB is enough for qwen3-vl:8b)
# LLM_BASE_URL=http://host.docker.internal:11434/v1
# LLM_API_KEY=ollama
# LLM_MODEL=qwen3-vl:8b

# --- Optional outbound proxy for selected hosts and media providers -----------
# OUTBOUND_PROXY=http://host.docker.internal:3128
# OUTBOUND_PROXY_HOSTS=api.deezer.com,openrouter.ai
# Add youtube.com and/or soundcloud.com to proxy the corresponding provider.
